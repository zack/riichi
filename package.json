{
  "name": "riichi-scoring-trainer",
  "version": "1.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check:compiler": "node scripts/checkCompiler.js",
    "check:hands": "node scripts/checkHands.js",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "husky",
    "preview": "vite preview",
    "cypress": "cypress open",
    "cypress:cli": "cypress run --browser chrome",
    "cypress:update-snapshots": "cypress run --browser chrome --spec cypress/e2e/visual.cy.js --expose visualRegressionType=base"
  },
  "dependencies": {
    "@radix-ui/themes": "^3.3.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "marked": "^18.1.1",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@rolldown/plugin-babel": "^0.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "cypress": "^15.21.1",
    "cypress-axe": "^1.7.0",
    "cypress-visual-regression": "^6.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^2.0.0"
  },
  "overrides": {
    "vite": "^8.1.5"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{css,json,md,yml,yaml,html}": [
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">=24",
    "pnpm": "please-use-npm",
    "yarn": "please-use-npm"
  }
}
